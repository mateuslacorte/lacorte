# Public (browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-string
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional — Vercel Blob for OG images / blog assets
BLOB_READ_WRITE_TOKEN=

# Public site origin for canonical + Open Graph URLs
NEXT_PUBLIC_SITE_URL=https://www.lacorte.dev

# Google Analytics 4 — omit locally if you do not want tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Google reCAPTCHA v3: register both application hostnames (and localhost).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
